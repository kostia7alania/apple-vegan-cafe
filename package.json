{
  "name": "apple-vegan-cafe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official website of Apple Vegan Cafe & Restaurant, Pattaya — static, multilingual (EN/TH/RU), progressively enhanced Astro site",
  "license": "MIT",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run validate:content && pnpm run generate:redirects && astro build --force",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . && prettier --check . --ignore-unknown",
    "format": "prettier --write . --ignore-unknown",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts && tsx scripts/check-article-prices.ts && tsx scripts/check-admin-config-parity.ts",
    "audit:links": "tsx scripts/audit-links.ts",
    "monitor:check": "tsx scripts/check-uptime-monitor.ts",
    "intake:check": "tsx scripts/check-intake.ts",
    "intake:round1": "tsx scripts/generate-round1-intake.ts",
    "funnel:report": "tsx scripts/funnel-report.ts",
    "generate:listing-packet": "tsx scripts/generate-listing-packet.ts",
    "generate:redirects": "tsx scripts/generate-redirects.ts",
    "grab:photos": "tsx scripts/grab-photo-recovery.ts",
    "import:menu": "tsx scripts/import-menu.ts",
    "privacy:check": "tsx scripts/check-private-data-boundary.ts",
    "deploy": "wrangler deploy --config infrastructure/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/literata": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
    "linkinator": "^7.6.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0",
    "yaml": "^2.9.0"
  }
}
