---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import JayBadge from '../../components/JayBadge.astro';
import ResponsiveMedia from '../../components/ResponsiveMedia.astro';
import { localeStaticPaths, LOCALES, type Locale } from '../../lib/i18n';
import { absoluteUrl, localePath, structuralAlternates } from '../../lib/urls';
import { buildBreadcrumb, buildMenu } from '../../lib/jsonld';
import { t, type UiKey } from '../../lib/ui';
import { getPublicDishDescription } from '../../lib/dishes';
import { orderingAnalyticsProvider, orderingCtaLabel } from '../../lib/ordering';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const [settings] = (await getCollection('settings')).map((e) => e.data);
const [operations] = (await getCollection('operations')).map((e) => e.data);
if (!settings || !operations) throw new Error('settings/operations content is missing');
// Only owner-confirmed links survive the schema/content gates and reach these CTAs.
const orderingLinks = settings.orderingLinks;
const pricePolicyText = t(
  locale,
  `operations.pricePolicy.${operations.pricePolicy ?? 'unknown'}` as UiKey,
);
const dietaryContact = operations.dietaryQuestionsContact;
const dietaryContactHref =
  dietaryContact === 'line'
    ? settings.lineUrl
    : dietaryContact === 'whatsapp'
      ? settings.whatsappUrl
      : dietaryContact === 'phone'
        ? `tel:${settings.phone.replace(/\s/g, '')}`
        : null;
const dietaryContactChannel =
  dietaryContact === 'phone'
    ? t(locale, 'operations.channel.phone')
    : dietaryContact === 'line'
      ? 'LINE'
      : dietaryContact === 'whatsapp'
        ? 'WhatsApp'
        : '';
const dietaryContactLabel =
  dietaryContact === 'phone'
    ? t(locale, 'operations.dietaryAskPhone')
    : t(locale, 'operations.dietaryAsk').replace('{channel}', dietaryContactChannel);
const spiceRequests = operations.spiceRequests;
const spiceRequestText =
  spiceRequests?.status === 'offered'
    ? t(locale, 'operations.spiceOffered').replace(
        '{levels}',
        spiceRequests.levels
          .map((level) => t(locale, `operations.spiceLevel.${level}` as UiKey))
          .join(', '),
      )
    : spiceRequests?.status === 'not-offered'
      ? t(locale, 'operations.spiceNotOffered')
      : null;

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
// The owner's "stop list": unavailable dishes disappear from the menu entirely.
const dishes = await getCollection('dishes', ({ data }) => data.available);
// A balanced, demand-informed menu starter set. Keep it local to this discovery surface so the
// homepage's editorial features remain an independent decision.
const MENU_QUICK_PICK_IDS = [
  'vegan-hamburger',
  'crispy-breaded-vegan-chicken',
  'stir-fried-mixed-vegetables',
  'hawaiian-pizza-vegan',
];
const featuredDishes = MENU_QUICK_PICK_IDS.flatMap((id) => {
  const dish = dishes.find((entry) => entry.id === id);
  return dish ? [dish] : [];
});
const allergens = await getCollection('allergens');
const allergenName = (id: string) => allergens.find((a) => a.id === id)?.data.name[locale] ?? id;
const largestImageCandidate = (asset: (typeof dishes)[number]['data']['images'][number]) => {
  const width = asset.srcLargeWidth ?? asset.srcSmallWidth ?? asset.width;
  const src = asset.srcLarge ?? asset.srcSmall ?? asset.src;
  return {
    src,
    width,
    height: Math.max(1, Math.round((asset.height / asset.width) * width)),
  };
};
const searchIndex = (dish: (typeof dishes)[number]['data'], categoryName: string) => {
  const description = getPublicDishDescription(dish);
  return [
    dish.name.en,
    dish.name.th,
    dish.name.ru,
    description?.en,
    description?.th,
    description?.ru,
    categoryName,
    ...dish.dietaryTags.flatMap((tag) =>
      LOCALES.map((tagLocale) => t(tagLocale, `tag.${tag}` as UiKey)),
    ),
    ...(dish.foodFacts.allergens.status === 'verified'
      ? dish.foodFacts.allergens.contains.map((allergen) => allergenName(allergen.id))
      : []),
    ...(dish.foodFacts.noGlutenIngredients === 'yes'
      ? [t(locale, 'menu.noGlutenIngredients')]
      : []),
    ...(dish.foodFacts.jainFriendly === 'yes' ? [t(locale, 'menu.jainRecipe')] : []),
  ]
    .filter(Boolean)
    .join(' ');
};

const nonEmptyCategories = categories.filter((category) =>
  dishes.some((d) => d.data.category.id === category.id),
);
const verifiedDietFilters: { value: 'no-gluten' | 'jain'; label: string }[] = [];
if (dishes.some(({ data }) => data.foodFacts.noGlutenIngredients === 'yes')) {
  verifiedDietFilters.push({ value: 'no-gluten', label: t(locale, 'menu.noGlutenIngredients') });
}
if (dishes.some(({ data }) => data.foodFacts.jainFriendly === 'yes')) {
  verifiedDietFilters.push({ value: 'jain', label: t(locale, 'menu.jainRecipe') });
}

const alternates = structuralAlternates('/menu/');
const site = Astro.site!;
const menuPageUrl = absoluteUrl(site, localePath(locale, '/menu/'));

const title = {
  en: 'Vegan menu & prices in Pattaya — Apple Vegan Cafe',
  th: 'เมนูอาหารเจ วีแกน และราคา พัทยา — Apple Vegan Cafe',
  ru: 'Веганское меню и цены в Паттайе — Apple Vegan Cafe',
}[locale];
const description = {
  en: `Browse ${dishes.length} vegan and jay dishes with photos and prices in Thai Baht: Thai food, Western favourites, snacks and drinks in Pattaya.`,
  th: `ดูเมนูวีแกนและอาหารเจ ${dishes.length} รายการ พร้อมรูปและราคา มีทั้งอาหารไทย อาหารตะวันตก ของทานเล่น และเครื่องดื่มในพัทยา`,
  ru: `В меню ${dishes.length} блюда: все веганские и джей, с фото и ценами в батах. Тайская и европейская кухня, закуски и напитки в Паттайе.`,
}[locale];

const jsonld = [
  buildBreadcrumb([
    { name: t(locale, 'nav.home'), url: absoluteUrl(site, localePath(locale, '/')) },
    { name: t(locale, 'nav.menu'), url: absoluteUrl(site, localePath(locale, '/menu/')) },
  ]),
  buildMenu({
    url: menuPageUrl,
    locale,
    sections: nonEmptyCategories.map((category) => ({
      name: category.data.name[locale],
      items: dishes
        .filter((d) => d.data.category.id === category.id)
        .map(({ data: dish }) => ({
          name: dish.name[locale],
          price: dish.price_thb,
          description: getPublicDishDescription(dish, locale),
          url: new URL(`#${dish.slug[locale]}`, menuPageUrl).href,
          suitableForDiet: 'https://schema.org/VeganDiet',
        })),
    })),
  }),
];
---

<Base {locale} {title} {description} {alternates} {jsonld} staticHeader>
  <section
    id="top"
    class="wrap grid gap-8 pt-8 pb-6 lg:grid-cols-[minmax(0,0.76fr)_minmax(0,1.24fr)] lg:items-start lg:gap-10 lg:pt-12 lg:pb-8"
  >
    <div class="min-w-0 lg:pt-4">
      <p class="text-center lg:text-left">
        <JayBadge label={t(locale, 'trust.jay')} />
      </p>
      <h1
        class="font-display mx-auto mt-4 max-w-[13ch] text-center text-4xl leading-[1.05] font-bold tracking-tight text-leaf-900 text-balance sm:text-5xl lg:mx-0 lg:text-left"
      >
        {t(locale, 'menu.title')}
      </h1>
      <p
        class="mx-auto mt-3 max-w-[40ch] text-center text-base leading-relaxed text-ink-700 text-pretty lg:mx-0 lg:text-left"
      >
        {t(locale, 'trust.honest')}
      </p>
      <p class="mt-2 text-center text-sm font-semibold text-leaf-700 lg:text-left">
        {t(locale, 'menu.catalogueSummary').replace('{count}', String(dishes.length))}
      </p>
      <p class="hidden print:block">
        Apple Vegan Cafe &amp; Restaurant · {t(locale, 'days.daily')} 7:00–22:00 · {settings.phone} ·
        apple-vegan-cafe.com
      </p>

      <search
        id="menu-search"
        data-menu-search
        data-results-template={t(locale, 'menu.resultsCount')}
        data-results-one={t(locale, 'menu.resultsCountOne')}
        hidden
        class="mt-6 scroll-mt-20 print:hidden"
      >
        <form data-menu-search-form action={localePath(locale, '/menu/')} method="get">
          <label for={`menu-search-${locale}`} class="block text-sm font-bold text-leaf-900">
            {t(locale, 'menu.searchLabel')}
          </label>
          <div class="mt-2 grid grid-cols-[minmax(0,1fr)_auto] gap-2">
            <input
              id={`menu-search-${locale}`}
              data-menu-search-input
              name="q"
              type="search"
              enterkeyhint="search"
              aria-describedby={`menu-search-status-${locale}`}
              placeholder={t(locale, 'menu.searchPlaceholder')}
              class="min-h-12 min-w-0 rounded-lg border border-cream-400 bg-cream-50 px-4 text-base text-ink-900 placeholder:text-ink-500/80 focus:border-leaf-700"
            />
            <button
              type="submit"
              class="min-h-12 rounded-lg bg-leaf-700 px-4 font-bold text-cream-50 transition-colors hover:bg-leaf-800 sm:px-5"
            >
              {t(locale, 'menu.searchAction')}
            </button>
          </div>
          <div class="mt-2 flex min-h-11 flex-wrap items-center gap-2 text-sm">
            <label
              class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-lg border border-cream-300 bg-cream-50 px-3 font-semibold text-ink-700 has-checked:border-leaf-700 has-checked:bg-leaf-50 has-checked:text-leaf-900"
            >
              <input
                data-menu-price-filter
                type="checkbox"
                name="price"
                value="150"
                class="h-4 w-4 shrink-0 accent-leaf-700"
              />
              <span class="sr-only">{t(locale, 'menu.priceFilter')}: </span>
              <span>{t(locale, 'menu.priceUpTo150')}</span>
            </label>
            {
              verifiedDietFilters.length > 0 && (
                <fieldset class="contents">
                  <legend class="sr-only">{t(locale, 'menu.verifiedDietFilter')}</legend>
                  {verifiedDietFilters.map((option) => (
                    <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-lg border border-cream-300 bg-cream-50 px-3 font-semibold text-ink-700 has-checked:border-leaf-700 has-checked:bg-leaf-50 has-checked:text-leaf-900">
                      <input
                        data-menu-diet-filter
                        type="checkbox"
                        name="diet"
                        value={option.value}
                        class="h-4 w-4 shrink-0 accent-leaf-700"
                      />
                      <span>{option.label}</span>
                    </label>
                  ))}
                </fieldset>
              )
            }
            <button
              data-menu-search-clear
              type="button"
              hidden
              class="ml-auto inline-flex min-h-11 items-center px-1 font-semibold text-leaf-700 underline decoration-mango-500 decoration-2 underline-offset-4 hover:text-leaf-900"
            >
              {t(locale, 'menu.clearFilters')}
            </button>
          </div>
          <p
            id={`menu-search-status-${locale}`}
            data-menu-search-status
            aria-live="polite"
            aria-atomic="true"
            hidden
            class="mt-2 text-sm font-semibold text-leaf-800"
          >
          </p>
        </form>
      </search>

      {
        orderingLinks.length > 1 && (
          <section
            id="delivery-options"
            aria-label={t(locale, 'ordering.deliveryOptions')}
            class="mt-5 scroll-mt-20 print:hidden"
          >
            <ul class="flex flex-wrap justify-center gap-2 lg:justify-start">
              {orderingLinks.map((link) => (
                <li>
                  <a
                    href={link.url}
                    rel="noopener"
                    data-analytics-event="order_click"
                    data-analytics-provider={orderingAnalyticsProvider(link.provider)}
                    class="inline-flex min-h-11 items-center rounded-lg bg-mango-500 px-5 text-sm font-extrabold text-ink-900 transition-colors hover:bg-mango-300 focus-visible:outline-mango-300"
                  >
                    {orderingCtaLabel(locale, link.provider)}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    {
      featuredDishes.length > 0 && (
        <section
          data-menu-quick-picks
          class="min-w-0 print:hidden"
          aria-labelledby={`quick-picks-${locale}`}
        >
          <div class="flex flex-wrap items-end justify-between gap-x-5 gap-y-1">
            <h2
              id={`quick-picks-${locale}`}
              class="font-display text-2xl font-bold text-leaf-900 sm:text-3xl"
            >
              {t(locale, 'menu.quickPicks')}
            </h2>
            <p class="text-sm text-ink-500">{t(locale, 'menu.quickPicksHint')}</p>
          </div>
          <ul class="scrollbar-subtle -mx-5 mt-3 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-2 lg:mx-0 lg:grid lg:grid-cols-2 lg:px-0">
            {featuredDishes.map(({ data: dish }, index) => (
              <li
                data-menu-quick-pick
                data-menu-quick-pick-target={dish.slug[locale]}
                class="w-[15.5rem] shrink-0 snap-start sm:w-[18rem] lg:w-auto"
              >
                <a
                  href={`#${dish.slug[locale]}`}
                  data-analytics-event="menu_popular_pick_click"
                  data-analytics-provider="grab"
                  class="group flex h-full flex-col overflow-hidden rounded-xl border border-cream-300 bg-cream-50 shadow-[0_16px_35px_-30px_rgba(38,34,27,0.55)] transition hover:-translate-y-0.5 hover:border-leaf-700/40 hover:shadow-[0_20px_38px_-28px_rgba(38,34,27,0.6)] motion-reduce:transform-none motion-reduce:transition-none"
                >
                  {dish.images[0] && (
                    <ResponsiveMedia
                      asset={dish.images[0]}
                      alt=""
                      eager={index === 0}
                      sizes="(min-width: 1024px) 280px, (min-width: 640px) 288px, 248px"
                      className="aspect-[4/3] w-full border-b border-cream-300 bg-cream-100 object-cover transition duration-300 group-hover:scale-[1.015] motion-reduce:transform-none motion-reduce:transition-none"
                    />
                  )}
                  <span class="flex flex-1 flex-col px-4 py-3">
                    <span class="text-[0.7rem] font-bold tracking-wide text-terracotta-700 uppercase">
                      {categories.find(({ id }) => id === dish.category.id)?.data.name[locale]}
                    </span>
                    <span class="mt-1 leading-snug font-extrabold text-ink-900 group-hover:text-leaf-800">
                      {dish.name[locale]}
                    </span>
                    <span class="mt-auto flex items-end justify-between gap-3 pt-3">
                      <span class="font-bold text-leaf-800 tabular-nums">฿{dish.price_thb}</span>
                      <span class="text-sm font-semibold text-leaf-700">
                        {t(locale, 'menu.viewDish')} →
                      </span>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-2 text-xs leading-relaxed text-ink-500">
            {t(locale, 'menu.catalogueImageNote')}
          </p>
        </section>
      )
    }
  </section>

  <section class="wrap pb-5 print:hidden" aria-label={t(locale, 'menu.dietGuidance')}>
    <div class="grid gap-3 lg:grid-cols-[minmax(0,1.35fr)_minmax(17rem,0.65fr)]">
      <details class="menu-guidance group rounded-xl border border-leaf-700/20 bg-leaf-50">
        <summary
          class="menu-guidance-summary flex min-h-16 cursor-pointer items-center gap-3 px-4 py-3 text-sm leading-relaxed text-ink-700"
        >
          <span
            lang="th"
            aria-hidden="true"
            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-mango-200 font-display text-base font-bold text-jay-700"
          >
            เจ
          </span>
          <span class="min-w-0 flex-1">
            <strong class="block font-bold text-leaf-900">{t(locale, 'menu.allVeganJay')}</strong>
            <span>{t(locale, 'menu.plantNamesNote')}</span>
          </span>
          <svg
            viewBox="0 0 24 24"
            class="h-5 w-5 shrink-0 text-leaf-700 transition-transform group-open:rotate-180"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <div class="border-t border-leaf-700/15 px-4 py-3 text-sm leading-relaxed text-ink-700">
          <p>
            <strong class="font-semibold text-leaf-900">{t(locale, 'menu.jayMeaningAction')}</strong
            >{' '}
            {t(locale, 'menu.jayMeaning')}
          </p>
          <p id={`diet-facts-note-${locale}`} class="mt-2">
            {t(locale, 'menu.dietFactsNote')}{' '}
            <a
              href={`${localePath(locale, '/faq/')}#cross-contact`}
              class="font-semibold text-leaf-700 underline decoration-mango-500 decoration-2 underline-offset-4 hover:text-leaf-900"
            >
              {t(locale, 'menu.dietGuidance')} →
            </a>
          </p>
          {
            dietaryContactHref && (
              <p class="mt-2">
                {t(locale, 'operations.dietaryPrompt')}{' '}
                <a
                  href={dietaryContactHref}
                  rel={dietaryContactHref.startsWith('https:') ? 'noopener' : undefined}
                  data-analytics-event="dietary_contact_click"
                  data-analytics-provider={dietaryContact}
                  class="font-semibold text-leaf-700 underline decoration-mango-500 decoration-2 underline-offset-4 hover:text-leaf-900"
                >
                  {dietaryContactLabel} →
                </a>
              </p>
            )
          }
        </div>
      </details>
      <aside
        class="flex items-start gap-3 rounded-xl border border-cream-300 bg-cream-50 px-4 py-3 text-sm leading-relaxed text-ink-700"
        aria-label={t(locale, 'menu.priceNote')}
      >
        <span
          aria-hidden="true"
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-mango-200 font-bold text-leaf-900"
        >
          ฿
        </span>
        <span>
          <strong class="block font-bold text-leaf-900">{t(locale, 'menu.priceNote')}</strong>
          {pricePolicyText}
        </span>
      </aside>
    </div>
  </section>

  {
    spiceRequests && spiceRequestText && (
      <aside class="wrap pb-5" aria-label={t(locale, 'operations.spiceQuestion')}>
        <div class="rounded-xl border border-mango-500/30 bg-mango-200/25 px-4 py-3 text-sm leading-relaxed text-ink-700">
          <p class="font-semibold text-leaf-900">{t(locale, 'operations.spiceQuestion')}</p>
          <p class="mt-1">{spiceRequestText}</p>
          {spiceRequests.scopeNote && <p class="mt-1">{spiceRequests.scopeNote[locale]}</p>}
        </div>
      </aside>
    )
  }

  <nav
    data-menu-category-nav
    aria-label={t(locale, 'menu.categoriesNav')}
    class="sticky top-0 z-30 border-y border-cream-300/80 bg-cream-100/95 backdrop-blur-md print:hidden"
  >
    <div class="wrap flex items-center gap-2">
      <a
        data-menu-search-jump
        hidden
        href="#menu-search"
        aria-label={t(locale, 'menu.searchLabel')}
        class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg bg-leaf-700 px-3 text-sm font-bold text-cream-50 transition-colors hover:bg-leaf-800 sm:px-4"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="hidden sm:inline">{t(locale, 'menu.searchAction')}</span>
      </a>
      <div class="min-w-0 flex-1 overflow-hidden">
        <ul class="scrollbar-subtle -mx-1 flex snap-x gap-2 overflow-x-auto px-1 py-3">
          {
            nonEmptyCategories.map((category) => (
              <li data-menu-category-link={category.id} class="snap-start">
                <a
                  data-menu-category-anchor={category.id}
                  href={`#${category.data.slug[locale]}`}
                  class="menu-category-anchor inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-leaf-700/20 bg-cream-50 px-4 text-sm font-semibold whitespace-nowrap text-leaf-800 transition-colors hover:border-leaf-700 hover:bg-leaf-100"
                >
                  {category.data.name[locale]}
                  <span class="text-xs font-normal text-ink-500 tabular-nums" aria-hidden="true">
                    {dishes.filter((d) => d.data.category.id === category.id).length}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        orderingLinks.length > 0 && (
          <a
            href={orderingLinks.length === 1 ? orderingLinks[0]!.url : '#delivery-options'}
            rel={orderingLinks.length === 1 ? 'noopener' : undefined}
            data-analytics-event={orderingLinks.length === 1 ? 'order_click' : undefined}
            data-analytics-provider={
              orderingLinks.length === 1
                ? orderingAnalyticsProvider(orderingLinks[0]!.provider)
                : undefined
            }
            class="hidden min-h-11 shrink-0 items-center rounded-lg bg-mango-500 px-4 text-sm font-extrabold text-ink-900 transition-colors hover:bg-mango-300 focus-visible:outline-mango-300 md:inline-flex"
          >
            {t(locale, 'actions.order')}
          </a>
        )
      }
    </div>
  </nav>

  <div class="wrap pb-4">
    {
      nonEmptyCategories.map((category, categoryIndex) => {
        const items = dishes.filter((d) => d.data.category.id === category.id);
        return (
          <section
            data-menu-section={category.id}
            id={category.data.slug[locale]}
            style={`--menu-estimate-mobile: ${Math.max(items.length * 9.75, 42)}rem; --menu-estimate-wide: ${Math.max(Math.ceil(items.length / 2) * 10.75, 42)}rem;`}
            class:list={['scroll-mt-20 pt-10', categoryIndex > 0 && 'menu-section-deferred']}
          >
            <div class="flex items-center gap-4">
              <h2 class="section-heading text-2xl font-black tracking-tight text-leaf-900 sm:text-3xl">
                {category.data.name[locale]}
              </h2>
              <span class="h-px flex-1 bg-cream-300" aria-hidden="true" />
            </div>
            <ul class="mt-4 grid gap-2 lg:grid-cols-2 lg:gap-3">
              {items.map(({ data: dish }) => (
                <li
                  data-menu-item
                  data-menu-search-index={searchIndex(dish, category.data.name[locale])}
                  data-menu-price={dish.price_thb}
                  data-menu-diet-no-gluten={
                    dish.foodFacts.noGlutenIngredients === 'yes' ? 'true' : 'false'
                  }
                  data-menu-diet-jain={dish.foodFacts.jainFriendly === 'yes' ? 'true' : 'false'}
                  id={dish.slug[locale]}
                  class="h-full scroll-mt-24 rounded-lg border border-cream-200 bg-cream-50/70 p-4 transition-colors hover:border-leaf-700/25 hover:bg-cream-50"
                >
                  <div
                    class:list={[
                      'grid items-start gap-4',
                      dish.images[0]
                        ? 'grid-cols-[minmax(0,1fr)_7rem] sm:grid-cols-[minmax(0,1fr)_9rem] lg:grid-cols-[minmax(0,1fr)_7rem]'
                        : 'grid-cols-1',
                    ]}
                  >
                    <div class="min-w-0">
                      <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-3">
                        <h3 class="text-base leading-snug font-extrabold sm:text-lg">
                          {dish.name[locale]}
                        </h3>
                        <span class="text-lg font-bold whitespace-nowrap text-leaf-800 tabular-nums">
                          ฿{dish.price_thb}
                        </span>
                      </div>
                      {getPublicDishDescription(dish, locale) && (
                        <p class="mt-1.5 max-w-[56ch] text-sm leading-relaxed text-ink-500">
                          {getPublicDishDescription(dish, locale)}
                        </p>
                      )}
                      {(dish.foodFacts.spicyLevel !== null ||
                        (dish.foodFacts.allergens.status === 'verified' &&
                          dish.foodFacts.allergens.contains.length > 0) ||
                        dish.foodFacts.noGlutenIngredients === 'yes' ||
                        dish.foodFacts.jainFriendly === 'yes') && (
                        <p class="mt-2.5 flex flex-wrap items-center gap-x-2 gap-y-1.5">
                          {dish.foodFacts.spicyLevel !== null &&
                            (dish.foodFacts.spicyLevel === 0 ? (
                              <span class="text-xs font-semibold text-ink-500">
                                {t(locale, 'menu.notSpicy')}
                              </span>
                            ) : (
                              <span
                                role="img"
                                aria-label={`${t(locale, 'menu.spicy')} ${dish.foodFacts.spicyLevel}/3`}
                                class="text-sm"
                              >
                                {'🌶'.repeat(dish.foodFacts.spicyLevel)}
                              </span>
                            ))}
                          {dish.foodFacts.allergens.status === 'verified' &&
                            dish.foodFacts.allergens.contains.length > 0 && (
                              <span class="text-xs text-ink-500 italic">
                                {t(locale, 'menu.contains')}:{' '}
                                {dish.foodFacts.allergens.contains
                                  .map((allergen) => allergenName(allergen.id))
                                  .join(', ')}
                              </span>
                            )}
                          {dish.foodFacts.noGlutenIngredients === 'yes' && (
                            <span class="rounded-full border border-leaf-700/25 bg-leaf-50 px-2 py-0.5 text-[11px] font-semibold text-leaf-800">
                              {t(locale, 'menu.noGlutenIngredients')}
                            </span>
                          )}
                          {dish.foodFacts.jainFriendly === 'yes' && (
                            <span class="rounded-full border border-leaf-700/25 bg-leaf-50 px-2 py-0.5 text-[11px] font-semibold text-leaf-800">
                              {t(locale, 'menu.jainRecipe')}
                            </span>
                          )}
                        </p>
                      )}
                    </div>
                    {dish.images[0] && (
                      <figure class="w-28 sm:w-36 lg:w-28">
                        <a
                          href={largestImageCandidate(dish.images[0]).src}
                          target="_blank"
                          rel="noopener"
                          data-menu-photo-open
                          data-photo-src={largestImageCandidate(dish.images[0]).src}
                          data-photo-width={largestImageCandidate(dish.images[0]).width}
                          data-photo-height={largestImageCandidate(dish.images[0]).height}
                          data-photo-name={dish.name[locale]}
                          aria-label={t(locale, 'menu.photoOpen').replace(
                            '{dish}',
                            dish.name[locale],
                          )}
                          class="group/photo relative block rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mango-500"
                        >
                          <ResponsiveMedia
                            asset={dish.images[0]}
                            alt={dish.name[locale]}
                            sizes="(min-width: 1024px) 112px, (min-width: 640px) 144px, 112px"
                            className="aspect-square w-full rounded-md border border-cream-300 bg-cream-100 object-cover shadow-sm transition group-hover/photo:brightness-95"
                          />
                          <span
                            aria-hidden="true"
                            class="absolute right-1.5 bottom-1.5 inline-flex h-7 w-7 items-center justify-center rounded-full bg-cream-50/90 text-leaf-800 shadow-sm backdrop-blur-sm"
                          >
                            <svg
                              viewBox="0 0 24 24"
                              class="h-4 w-4"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                            >
                              <circle cx="11" cy="11" r="6" />
                              <path d="m16 16 4 4" />
                              <path d="M11 8v6M8 11h6" />
                            </svg>
                          </span>
                        </a>
                        {dish.images[0].credit && (
                          <figcaption class="mt-1 text-[10px] leading-tight break-words text-ink-500">
                            {t(locale, 'media.credit')}: {dish.images[0].credit}
                          </figcaption>
                        )}
                      </figure>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
    <div
      data-menu-no-results
      hidden
      class="my-12 rounded-lg border border-cream-300 bg-cream-50 px-6 py-10 text-center text-lg font-semibold text-ink-700"
    >
      <p
        data-menu-no-results-message
        data-default-message={t(locale, 'menu.noResults')}
        data-verified-message={t(locale, 'menu.noVerifiedResults')}
      >
        {t(locale, 'menu.noResults')}
      </p>
      <a
        href={localePath(locale, '/menu/')}
        class="mt-4 inline-flex min-h-11 items-center rounded-lg border border-leaf-700/30 bg-leaf-50 px-5 text-sm font-bold text-leaf-800 hover:bg-cream-100"
      >
        {t(locale, 'menu.showAllDishes')}
      </a>
    </div>
    {
      orderingLinks.length > 0 && (
        <section class="decor-card mt-14 mb-10 rounded-lg border border-leaf-100 bg-leaf-50 px-6 py-8 text-center sm:px-10 print:hidden">
          <p class="text-xl font-black text-leaf-900">{t(locale, 'menu.orderClosing')}</p>
          <ul class="mt-4 flex flex-wrap justify-center gap-3">
            {orderingLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  rel="noopener"
                  data-analytics-event="order_click"
                  data-analytics-provider={orderingAnalyticsProvider(link.provider)}
                  class="inline-flex min-h-12 items-center rounded-lg bg-leaf-700 px-7 font-bold text-cream-50 transition-colors hover:bg-leaf-800"
                >
                  {orderingCtaLabel(locale, link.provider)}
                </a>
              </li>
            ))}
          </ul>
          {dietaryContactHref && (
            <p class="mt-4 text-sm leading-relaxed text-ink-700">
              {t(locale, 'operations.dietaryPrompt')}{' '}
              <a
                href={dietaryContactHref}
                rel={dietaryContactHref.startsWith('https:') ? 'noopener' : undefined}
                data-analytics-event="dietary_contact_click"
                data-analytics-provider={dietaryContact}
                class="font-semibold text-leaf-700 underline decoration-mango-500 decoration-2 underline-offset-4 hover:text-leaf-900"
              >
                {dietaryContactLabel} →
              </a>
            </p>
          )}
        </section>
      )
    }
  </div>

  <dialog
    data-menu-photo-dialog
    aria-labelledby={`menu-photo-caption-${locale}`}
    class="menu-photo-dialog m-auto max-h-[92dvh] w-[min(92vw,64rem)] overflow-hidden rounded-xl border border-cream-300 bg-cream-50 p-0 text-ink-900 shadow-2xl"
  >
    <figure class="relative grid max-h-[92dvh] grid-rows-[minmax(0,1fr)_auto]">
      <form method="dialog" class="absolute top-3 right-3 z-10">
        <button
          value="close"
          aria-label={t(locale, 'menu.photoClose')}
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-cream-300 bg-cream-50/95 text-2xl leading-none text-leaf-900 shadow-md backdrop-blur-sm hover:bg-cream-100"
        >
          <span aria-hidden="true">×</span>
        </button>
      </form>
      <img
        data-menu-photo-dialog-image
        alt=""
        width="1"
        height="1"
        class="max-h-[80dvh] w-full bg-cream-100 object-contain"
      />
      <figcaption
        id={`menu-photo-caption-${locale}`}
        data-menu-photo-dialog-caption
        class="border-t border-cream-300 px-5 py-3 font-bold text-leaf-900"
      >
      </figcaption>
    </figure>
  </dialog>

  <script>
    const searchRoot = document.querySelector<HTMLElement>('[data-menu-search]');

    if (searchRoot) {
      const form = searchRoot.querySelector<HTMLFormElement>('[data-menu-search-form]');
      const input = searchRoot.querySelector<HTMLInputElement>('[data-menu-search-input]');
      const clearButton = searchRoot.querySelector<HTMLButtonElement>('[data-menu-search-clear]');
      const status = searchRoot.querySelector<HTMLElement>('[data-menu-search-status]');
      const priceInputs = Array.from(
        searchRoot.querySelectorAll<HTMLInputElement>('[data-menu-price-filter]'),
      );
      const dietInputs = Array.from(
        searchRoot.querySelectorAll<HTMLInputElement>('[data-menu-diet-filter]'),
      );
      const noResults = document.querySelector<HTMLElement>('[data-menu-no-results]');
      const noResultsMessage = noResults?.querySelector<HTMLElement>(
        '[data-menu-no-results-message]',
      );
      const items = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-item]'));
      const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-section]'));
      const categoryLinks = Array.from(
        document.querySelectorAll<HTMLElement>('[data-menu-category-link]'),
      );
      const categoryAnchors = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-menu-category-anchor]'),
      );
      const categoryNav = document.querySelector<HTMLElement>('[data-menu-category-nav]');
      const searchJump = document.querySelector<HTMLAnchorElement>('[data-menu-search-jump]');
      const quickPicksRoot = document.querySelector<HTMLElement>('[data-menu-quick-picks]');
      const quickPicks = Array.from(
        document.querySelectorAll<HTMLElement>('[data-menu-quick-pick]'),
      );
      const resultsTemplate = searchRoot.dataset.resultsTemplate ?? '{count}';
      const resultsOne = searchRoot.dataset.resultsOne ?? resultsTemplate;
      const recognizedDietFilters = new Set(['no-gluten', 'jain']);
      let unavailableInitialDietFilters = new Set<string>();
      let updateTimer = 0;

      const setActiveCategory = (categoryId: string | undefined) => {
        categoryAnchors.forEach((anchor) => {
          if (anchor.dataset.menuCategoryAnchor === categoryId) {
            anchor.setAttribute('aria-current', 'location');
            if (categoryNav && categoryNav.getBoundingClientRect().top <= 112) {
              anchor.scrollIntoView({ block: 'nearest', inline: 'nearest' });
            }
          } else {
            anchor.removeAttribute('aria-current');
          }
        });
      };

      const normalize = (value: string) =>
        value.normalize('NFKD').replace(/\p{M}/gu, '').toLocaleLowerCase().trim();

      const applySearch = (updateUrl = false) => {
        if (!input || !status || !clearButton || !noResults || !noResultsMessage) return;

        const queryTokens = normalize(input.value).split(/\s+/).filter(Boolean);
        const selectedPrice = priceInputs.find((priceInput) => priceInput.checked)?.value ?? 'all';
        const selectedDiet = dietInputs
          .filter((dietInput) => dietInput.checked)
          .map((dietInput) => dietInput.value);
        unavailableInitialDietFilters.forEach((filter) => selectedDiet.push(filter));
        const maxPrice = selectedPrice === 'all' ? Number.POSITIVE_INFINITY : Number(selectedPrice);
        let visibleCount = 0;

        items.forEach((item) => {
          const normalizedIndex = normalize(item.dataset.menuSearchIndex ?? '');
          const matchesQuery = queryTokens.every((token) => normalizedIndex.includes(token));
          const matchesPrice = Number(item.dataset.menuPrice) <= maxPrice;
          const matchesDiet = selectedDiet.every((filter) =>
            filter === 'no-gluten'
              ? item.dataset.menuDietNoGluten === 'true'
              : item.dataset.menuDietJain === 'true',
          );
          const matches = matchesQuery && matchesPrice && matchesDiet;
          item.hidden = !matches;
          if (matches) visibleCount += 1;
        });

        sections.forEach((section) => {
          const hasVisibleItems = Array.from(
            section.querySelectorAll<HTMLElement>('[data-menu-item]'),
          ).some((item) => !item.hidden);
          section.hidden = !hasVisibleItems;
        });

        categoryLinks.forEach((link) => {
          const section = sections.find(
            (candidate) => candidate.dataset.menuSection === link.dataset.menuCategoryLink,
          );
          link.hidden = Boolean(section?.hidden);
        });

        quickPicks.forEach((quickPick) => {
          const target = items.find((item) => item.id === quickPick.dataset.menuQuickPickTarget);
          quickPick.hidden = !target || target.hidden;
        });
        if (quickPicksRoot) {
          quickPicksRoot.hidden = quickPicks.every((quickPick) => quickPick.hidden);
        }

        const activeAnchor = categoryAnchors.find((anchor) => anchor.hasAttribute('aria-current'));
        const activeSection = sections.find(
          (section) => section.dataset.menuSection === activeAnchor?.dataset.menuCategoryAnchor,
        );
        if (!activeSection || activeSection.hidden) {
          setActiveCategory(sections.find((section) => !section.hidden)?.dataset.menuSection);
        }

        const hasActiveFilters =
          queryTokens.length > 0 || selectedPrice !== 'all' || selectedDiet.length > 0;
        clearButton.hidden = !hasActiveFilters;
        noResults.hidden = visibleCount > 0;
        noResultsMessage.textContent =
          selectedDiet.length > 0
            ? (noResultsMessage.dataset.verifiedMessage ?? '')
            : (noResultsMessage.dataset.defaultMessage ?? '');
        status.hidden = !hasActiveFilters;
        status.textContent = hasActiveFilters
          ? (visibleCount === 1 ? resultsOne : resultsTemplate).replace(
              '{count}',
              String(visibleCount),
            )
          : '';

        if (updateUrl) {
          const nextUrl = new URL(window.location.href);
          if (queryTokens.length > 0) nextUrl.searchParams.set('q', input.value.trim());
          else nextUrl.searchParams.delete('q');

          if (selectedPrice === 'all') nextUrl.searchParams.delete('price');
          else nextUrl.searchParams.set('price', selectedPrice);

          if (selectedDiet.length > 0) {
            nextUrl.searchParams.set('diet', selectedDiet.join(','));
          } else {
            nextUrl.searchParams.delete('diet');
          }
          nextUrl.hash = '';
          window.history.replaceState({}, '', nextUrl);
        }
      };

      const scheduleSearch = () => {
        window.clearTimeout(updateTimer);
        updateTimer = window.setTimeout(() => applySearch(true), 140);
      };

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        window.clearTimeout(updateTimer);
        applySearch(true);
      });
      input?.addEventListener('input', scheduleSearch);
      priceInputs.forEach((priceInput) => priceInput.addEventListener('change', scheduleSearch));
      dietInputs.forEach((dietInput) =>
        dietInput.addEventListener('change', () => {
          unavailableInitialDietFilters.clear();
          scheduleSearch();
        }),
      );
      input?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && input.value) {
          input.value = '';
          applySearch(true);
        }
      });
      clearButton?.addEventListener('click', () => {
        if (!input) return;
        input.value = '';
        priceInputs.forEach((priceInput) => {
          priceInput.checked = false;
        });
        dietInputs.forEach((dietInput) => {
          dietInput.checked = false;
        });
        unavailableInitialDietFilters.clear();
        applySearch(true);
        input.focus();
      });

      const searchParams = new URLSearchParams(window.location.search);
      if (input) input.value = searchParams.get('q') ?? '';
      const initialPrice = searchParams.get('price');
      if (initialPrice) {
        const matchingPrice = priceInputs.find((priceInput) => priceInput.value === initialPrice);
        if (matchingPrice) matchingPrice.checked = true;
      }
      const initialDiet = new Set(
        (searchParams.get('diet') ?? '')
          .split(',')
          .filter((value) => recognizedDietFilters.has(value)),
      );
      dietInputs.forEach((dietInput) => {
        dietInput.checked = initialDiet.has(dietInput.value);
      });
      unavailableInitialDietFilters = new Set(
        [...initialDiet].filter(
          (filter) => !dietInputs.some((dietInput) => dietInput.value === filter),
        ),
      );
      searchRoot.hidden = false;
      if (searchJump) searchJump.hidden = false;
      applySearch();

      categoryAnchors.forEach((anchor) =>
        anchor.addEventListener('click', () =>
          setActiveCategory(anchor.dataset.menuCategoryAnchor),
        ),
      );
      if ('IntersectionObserver' in window) {
        const visibleSections = new Set<Element>();
        const sectionObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) visibleSections.add(entry.target);
              else visibleSections.delete(entry.target);
            });
            const activeSection = sections
              .filter((section) => visibleSections.has(section) && !section.hidden)
              .sort(
                (left, right) =>
                  left.getBoundingClientRect().top - right.getBoundingClientRect().top,
              )[0];
            if (activeSection) setActiveCategory(activeSection.dataset.menuSection);
          },
          { rootMargin: '-88px 0px -60% 0px' },
        );
        sections.forEach((section) => sectionObserver.observe(section));
      }
    }

    const photoDialog = document.querySelector<HTMLDialogElement>('[data-menu-photo-dialog]');
    const photoDialogImage = photoDialog?.querySelector<HTMLImageElement>(
      '[data-menu-photo-dialog-image]',
    );
    const photoDialogCaption = photoDialog?.querySelector<HTMLElement>(
      '[data-menu-photo-dialog-caption]',
    );
    if (photoDialog && photoDialogImage && photoDialogCaption && photoDialog.showModal) {
      document.querySelectorAll<HTMLAnchorElement>('[data-menu-photo-open]').forEach((opener) => {
        opener.addEventListener('click', (event) => {
          event.preventDefault();
          const { photoSrc, photoWidth, photoHeight, photoName } = opener.dataset;
          if (!photoSrc || !photoWidth || !photoHeight || !photoName) return;
          photoDialogImage.src = photoSrc;
          photoDialogImage.width = Number(photoWidth);
          photoDialogImage.height = Number(photoHeight);
          photoDialogImage.alt = photoName;
          photoDialogCaption.textContent = photoName;
          photoDialog.showModal();
        });
      });
      photoDialog.addEventListener('click', (event) => {
        if (event.target === photoDialog) photoDialog.close();
      });
      photoDialog.addEventListener('close', () => {
        photoDialogImage.removeAttribute('src');
        photoDialogImage.alt = '';
        photoDialogCaption.textContent = '';
      });
    }
  </script>
</Base>
