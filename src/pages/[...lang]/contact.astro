---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LeafDivider from '../../components/LeafDivider.astro';
import Sprig from '../../components/Sprig.astro';
import SpecialHoursNotice from '../../components/SpecialHoursNotice.astro';
import ResponsiveMedia from '../../components/ResponsiveMedia.astro';
import { localeStaticPaths, type Locale } from '../../lib/i18n';
import { absoluteAssetUrl, absoluteUrl, localePath, structuralAlternates } from '../../lib/urls';
import { buildBreadcrumb, buildRestaurant } from '../../lib/jsonld';
import { getPublishableMedia, isPublishableMedia } from '../../lib/media';
import { t, type UiKey } from '../../lib/ui';
import { orderingAnalyticsProvider, orderingCtaLabel } from '../../lib/ordering';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const [settings] = (await getCollection('settings')).map((e) => e.data);
const [location] = (await getCollection('locations')).map((e) => e.data);
const [operations] = (await getCollection('operations')).map((e) => e.data);
const [siteMedia] = (await getCollection('siteMedia')).map((e) => e.data);
if (!settings || !location || !operations || !siteMedia) {
  throw new Error('settings/locations/operations/site-media content is missing');
}
const exteriorMedia = getPublishableMedia(siteMedia.assets, 'exterior');
const restaurantImages = [
  ...new Set(
    siteMedia.assets
      .filter(isPublishableMedia)
      .map((asset) => absoluteAssetUrl(Astro.site!, asset.src)),
  ),
];

const alternates = structuralAlternates('/contact/');
const site = Astro.site!;
const orderingLinks = settings.orderingLinks;

const title = {
  en: 'Contact & address — Apple Vegan Cafe Pattaya',
  th: 'ติดต่อและที่อยู่ — ร้านอาหารเจ คาเฟ่เจ พัทยา',
  ru: 'Контакты и адрес — Apple Vegan Cafe, Паттайя',
}[locale];
const description = {
  en: 'Address, opening hours and phone for Apple Vegan Cafe & Restaurant in Pattaya (Bang Lamung, Chonburi).',
  th: 'ที่อยู่ เวลาเปิด-ปิด และโทรศัพท์ของร้านอาหารเจ คาเฟ่เจ พัทยา',
  ru: 'Адрес, часы работы и телефон Apple Vegan Cafe в Паттайе (Банг Ламунг, Чонбури).',
}[locale];

const jsonld = [
  buildRestaurant({
    name: settings.name,
    url: absoluteUrl(site, '/'),
    menuUrl: absoluteUrl(site, localePath(locale, '/menu/')),
    telephone: settings.phone,
    address: location.address.en,
    geo: location.geo,
    hasMap: location.mapsUrl,
    images: restaurantImages,
    sameAs: [
      ...settings.social.map((s) => s.url),
      ...(settings.reviewLinks.googleProfile ? [settings.reviewLinks.googleProfile] : []),
      ...(settings.reviewLinks.happycow ? [settings.reviewLinks.happycow] : []),
      ...(settings.reviewLinks.tripadvisor ? [settings.reviewLinks.tripadvisor] : []),
    ],
    hours: location.hours,
    specialHours: location.specialHours,
    orderUrl: orderingLinks[0]?.url,
  }),
  buildBreadcrumb([
    { name: t(locale, 'nav.home'), url: absoluteUrl(site, localePath(locale, '/')) },
    { name: t(locale, 'nav.contact'), url: absoluteUrl(site, localePath(locale, '/contact/')) },
  ]),
];

const dayLabel = (day: string) => t(locale, `days.${day}` as UiKey);
const daysLabel = (days: readonly string[]) =>
  days.length === 7
    ? t(locale, 'days.daily')
    : days.length > 2
      ? `${dayLabel(days[0]!)}–${dayLabel(days.at(-1)!)}`
      : days.map(dayLabel).join(', ');
const phoneHref = `tel:${settings.phone.replace(/\s/g, '')}`;
const pickupContact = operations.pickup?.contact;
const pickupHref = !pickupContact
  ? null
  : pickupContact === 'line'
    ? settings.lineUrl
    : pickupContact === 'whatsapp'
      ? settings.whatsappUrl
      : phoneHref;
const reservationContact = operations.reservations?.contact;
const reservationHref = !reservationContact
  ? null
  : reservationContact === 'line'
    ? settings.lineUrl
    : reservationContact === 'whatsapp'
      ? settings.whatsappUrl
      : phoneHref;
const reservationIsPublishable = Boolean(
  operations.reservations && (operations.reservations.status === 'not-accepted' || reservationHref),
);
const reservationPolicyText =
  operations.reservations?.status === 'large-groups-only'
    ? t(locale, 'operations.reservationLargeGroups').replace(
        '{count}',
        String(operations.reservations.minimumPartySize),
      )
    : operations.reservations?.status === 'accepted'
      ? t(locale, 'operations.reservationAccepted')
      : operations.reservations?.status === 'not-accepted'
        ? t(locale, 'operations.reservationNotAccepted')
        : null;
const paymentLabels = operations.paymentMethods.map((method) =>
  t(locale, `operations.payment.${method}` as UiKey),
);
---

<Base {locale} {title} {description} {alternates} {jsonld}>
  <div class="page-shell wrap py-10 sm:py-14">
    <h1
      class="page-heading font-display text-4xl leading-tight font-extrabold tracking-tight text-leaf-900 sm:text-5xl"
    >
      {t(locale, 'nav.contact')}
    </h1>
    <LeafDivider class="mt-6 max-w-52 sm:max-w-60" />

    {
      /* Balanced two-column composition: address + phone stacked left,
        full-height hours card right (with a corner sprig). */
    }
    <div class="mt-8 grid items-start gap-5 sm:grid-cols-2">
      <div class="grid gap-5">
        <section class="decor-card rounded-lg border border-cream-300 bg-cream-50 p-6 sm:p-7">
          <h2
            class="flex items-center gap-2 text-xs font-bold tracking-[0.14em] text-terracotta-700 uppercase"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            {t(locale, 'contact.address')}
          </h2>
          <p class="mt-3 text-lg leading-relaxed">{location.address[locale]}</p>
          {
            location.landmark && (
              <p class="mt-3 text-sm leading-relaxed text-ink-700">
                <strong>{t(locale, 'contact.landmark')}:</strong> {location.landmark[locale]}
              </p>
            )
          }
          {
            location.parking && (
              <p class="mt-2 text-sm leading-relaxed text-ink-700">
                <strong>{t(locale, 'contact.parking')}:</strong> {location.parking[locale]}
              </p>
            )
          }
          {
            location.arrivalNote && (
              <p class="mt-2 text-sm leading-relaxed text-ink-700">
                <strong>{t(locale, 'contact.arrivalNote')}:</strong> {location.arrivalNote[locale]}
              </p>
            )
          }
          {
            locale !== 'th' && (
              <div class="mt-4 rounded-lg border border-cream-300 bg-cream-100 px-4 py-3">
                <p class="text-xs font-bold tracking-wide text-terracotta-700 uppercase">
                  {t(locale, 'contact.driverAddress')}
                </p>
                <p lang="th" class="mt-1.5 leading-relaxed text-ink-900">
                  {location.address.th}
                </p>
              </div>
            )
          }
          {
            location.mapsUrl && (
              <a
                href={location.mapsUrl}
                rel="noopener"
                class="mt-5 inline-flex min-h-12 items-center rounded-lg border border-leaf-700/40 px-6 font-semibold text-leaf-800 transition-colors hover:border-leaf-700 hover:bg-leaf-100"
              >
                {t(locale, 'contact.findUs')}
              </a>
            )
          }
          {
            exteriorMedia && (
              <figure class="mt-5">
                <ResponsiveMedia
                  asset={exteriorMedia}
                  alt={exteriorMedia.alt[locale]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  className="aspect-4/3 w-full rounded-lg border border-cream-300 object-cover sm:aspect-3/2"
                />
                {exteriorMedia.credit && (
                  <figcaption class="mt-1.5 text-xs text-ink-500">
                    {t(locale, 'media.credit')}: {exteriorMedia.credit}
                  </figcaption>
                )}
              </figure>
            )
          }
        </section>

        <section class="decor-card rounded-lg border border-cream-300 bg-cream-50 p-6 sm:p-7">
          <h2
            class="flex items-center gap-2 text-xs font-bold tracking-[0.14em] text-terracotta-700 uppercase"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            {t(locale, 'contact.phone')}
          </h2>
          <p class="mt-3 text-sm text-ink-500">{t(locale, 'contact.callUs')}</p>
          <a
            href={phoneHref}
            class="mt-4 inline-flex min-h-13 w-full items-center justify-center rounded-lg bg-leaf-700 px-6 text-lg font-bold text-cream-50 transition-colors hover:bg-leaf-800 sm:w-auto"
          >
            {settings.phone}
          </a>
          {
            settings.lineUrl && (
              <p class="mt-4">
                <a
                  href={settings.lineUrl}
                  rel="noopener"
                  class="font-semibold text-leaf-700 underline decoration-mango-500 decoration-2 underline-offset-4 hover:text-leaf-900"
                >
                  LINE
                </a>
              </p>
            )
          }
          {
            settings.whatsappUrl && (
              <p class="mt-3">
                <a
                  href={settings.whatsappUrl}
                  rel="noopener"
                  class="font-semibold text-leaf-700 underline decoration-mango-500 decoration-2 underline-offset-4 hover:text-leaf-900"
                >
                  WhatsApp
                </a>
              </p>
            )
          }
          {
            settings.email && (
              <p class="mt-3">
                <a
                  href={`mailto:${settings.email}`}
                  class="font-semibold text-leaf-700 underline decoration-mango-500 decoration-2 underline-offset-4 hover:text-leaf-900"
                >
                  {settings.email}
                </a>
              </p>
            )
          }
          {
            settings.responseHours && (
              <p class="mt-4 text-sm leading-relaxed text-ink-500">
                {t(locale, 'contact.responseHours')}: {settings.responseHours[locale]}
              </p>
            )
          }
        </section>
      </div>

      <section
        class="decor-card relative overflow-hidden rounded-lg border border-cream-300 bg-cream-50 p-6 sm:h-full sm:p-7"
      >
        <Sprig
          class="pointer-events-none absolute -right-5 -bottom-7 h-40 w-auto text-leaf-700 opacity-[0.12]"
        />
        <h2
          class="flex items-center gap-2 text-xs font-bold tracking-[0.14em] text-terracotta-700 uppercase"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 6v6l4 2"></path>
          </svg>
          {t(locale, 'contact.hours')}
        </h2>
        <table class="mt-4 w-full max-w-md text-base">
          <caption class="sr-only">{t(locale, 'contact.hours')}</caption>
          <tbody class="divide-y divide-cream-200">
            {
              location.hours.map((h) => (
                <tr data-special-hours-replaced>
                  <th scope="row" class="py-2.5 pr-6 text-left font-medium">
                    {daysLabel(h.days)}
                  </th>
                  <td class="py-2.5 font-semibold text-leaf-800 tabular-nums">
                    {h.open}–{h.close}
                  </td>
                </tr>
              ))
            }
            {
              orderingLinks.length > 0 && (
                <tr>
                  <th scope="row" class="py-2.5 pr-6 text-left font-medium">
                    {t(locale, 'hours.delivery')}
                  </th>
                  <td class="py-2.5 font-semibold text-leaf-800">
                    {t(locale, 'hours.deliveryValue')}
                  </td>
                </tr>
              )
            }
          </tbody>
        </table>
        <SpecialHoursNotice
          {locale}
          specialHours={location.specialHours}
          className="mt-4 max-w-md"
        />
        {
          orderingLinks.length > 0 && (
            <div class="mt-4 max-w-[46ch]">
              <p class="text-sm leading-relaxed text-ink-500">
                🌙 {t(locale, 'contact.nightOrders')}
              </p>
              <ul
                class="mt-3 flex flex-wrap gap-2"
                aria-label={t(locale, 'ordering.deliveryOptions')}
              >
                {orderingLinks.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      rel="noopener"
                      data-analytics-event="order_click"
                      data-analytics-provider={orderingAnalyticsProvider(link.provider)}
                      class="inline-flex min-h-11 items-center rounded-lg bg-mango-500 px-4 text-sm font-bold text-ink-900 transition-colors hover:bg-mango-300 focus-visible:outline-mango-300"
                    >
                      {orderingCtaLabel(locale, link.provider)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <p class="relative mt-5">
          <a
            href={`${localePath(locale, '/faq/')}${paymentLabels.length > 0 ? '#payment' : ''}`}
            class="font-semibold text-leaf-700 underline decoration-mango-500 decoration-2 underline-offset-4 hover:text-leaf-900"
          >
            {
              t(
                locale,
                paymentLabels.length > 0
                  ? 'contact.visitQuestions'
                  : 'contact.visitQuestionsWithoutPayment',
              )
            }{' '}
            →
          </a>
        </p>
      </section>
    </div>
    {
      (paymentLabels.length > 0 || operations.pickup?.enabled || reservationIsPublishable) && (
        <section class="mt-5 grid gap-5 rounded-lg border border-cream-300 bg-cream-50 p-6 sm:grid-cols-2 sm:p-7">
          {paymentLabels.length > 0 && (
            <div>
              <h2 class="text-xs font-bold tracking-[0.14em] text-terracotta-700 uppercase">
                {t(locale, 'operations.payment')}
              </h2>
              <p class="mt-3 font-semibold text-leaf-900">{paymentLabels.join(' · ')}</p>
              {operations.paymentNote && (
                <p class="mt-2 text-sm leading-relaxed text-ink-500">
                  {operations.paymentNote[locale]}
                </p>
              )}
            </div>
          )}
          {operations.pickup?.enabled && (
            <div>
              <h2 class="text-xs font-bold tracking-[0.14em] text-terracotta-700 uppercase">
                {t(locale, 'operations.pickup')}
              </h2>
              <p class="mt-3 font-semibold text-leaf-900">
                {t(locale, 'operations.pickupAvailable')}
              </p>
              {operations.pickup.leadTime && (
                <p class="mt-2 text-sm leading-relaxed text-ink-500">
                  {operations.pickup.leadTime[locale]}
                </p>
              )}
              {operations.pickup.priceNote && (
                <p class="mt-2 text-sm leading-relaxed text-ink-500">
                  {operations.pickup.priceNote[locale]}
                </p>
              )}
              {pickupHref && (
                <a
                  href={pickupHref}
                  rel={pickupHref.startsWith('https:') ? 'noopener' : undefined}
                  class="mt-4 inline-flex min-h-11 items-center rounded-lg bg-leaf-700 px-5 font-bold text-cream-50 hover:bg-leaf-800"
                >
                  {operations.pickup.contact === 'phone'
                    ? t(locale, 'actions.call')
                    : operations.pickup.contact === 'line'
                      ? 'LINE'
                      : 'WhatsApp'}
                </a>
              )}
            </div>
          )}
          {operations.reservations && reservationIsPublishable && reservationPolicyText && (
            <div id="reservations" class="scroll-mt-32">
              <h2 class="text-xs font-bold tracking-[0.14em] text-terracotta-700 uppercase">
                {t(locale, 'operations.reservations')}
              </h2>
              <p class="mt-3 font-semibold text-leaf-900">{reservationPolicyText}</p>
              {operations.reservations.leadTime && (
                <p class="mt-2 text-sm leading-relaxed text-ink-500">
                  {operations.reservations.leadTime[locale]}
                </p>
              )}
              {operations.reservations.note && (
                <p class="mt-2 text-sm leading-relaxed text-ink-500">
                  {operations.reservations.note[locale]}
                </p>
              )}
              {operations.reservations.status !== 'not-accepted' && reservationHref && (
                <a
                  href={reservationHref}
                  rel={reservationHref.startsWith('https:') ? 'noopener' : undefined}
                  class="mt-4 inline-flex min-h-11 items-center rounded-lg bg-leaf-700 px-5 font-bold text-cream-50 hover:bg-leaf-800"
                >
                  {t(locale, 'operations.reservationRequest')} ·{' '}
                  {reservationContact === 'phone'
                    ? t(locale, 'actions.call')
                    : reservationContact === 'line'
                      ? 'LINE'
                      : 'WhatsApp'}
                </a>
              )}
            </div>
          )}
        </section>
      )
    }
  </div>
</Base>
