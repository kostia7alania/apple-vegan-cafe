---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LeafDivider from '../../components/LeafDivider.astro';
import Sprig from '../../components/Sprig.astro';
import ResponsiveMedia from '../../components/ResponsiveMedia.astro';
import { localeStaticPaths, type Locale } from '../../lib/i18n';
import { absoluteUrl, localePath, structuralAlternates } from '../../lib/urls';
import { buildBreadcrumb } from '../../lib/jsonld';
import { getPublishableMedia } from '../../lib/media';
import { t } from '../../lib/ui';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const entry = (
  await getCollection(
    'pages',
    ({ data }) => data.translationKey === 'about' && data.locale === locale,
  )
)[0];
if (!entry) throw new Error(`about page missing for locale ${locale}`);
const { Content } = await render(entry);
const [siteMedia] = (await getCollection('siteMedia')).map((item) => item.data);
if (!siteMedia) throw new Error('site-media content is missing');
const familyMedia = getPublishableMedia(siteMedia.assets, 'family');
const interiorMedia = getPublishableMedia(siteMedia.assets, 'interior');

const alternates = structuralAlternates('/about/');
const site = Astro.site!;
const jsonld = [
  buildBreadcrumb([
    { name: t(locale, 'nav.home'), url: absoluteUrl(site, localePath(locale, '/')) },
    { name: t(locale, 'nav.about'), url: absoluteUrl(site, localePath(locale, '/about/')) },
  ]),
];
---

<Base {locale} title={entry.data.title} description={entry.data.description} {alternates} {jsonld}>
  <article class="page-shell wrap relative py-10 sm:py-14">
    <Sprig
      class="pointer-events-none absolute top-10 right-0 hidden h-72 w-auto rotate-12 text-leaf-700 opacity-[0.1] lg:block"
    />
    <div class="mx-auto max-w-[65ch]">
      <header>
        <h1
          class="page-heading page-heading-wide font-display text-4xl leading-tight font-extrabold tracking-tight text-leaf-900 sm:text-5xl"
        >
          {entry.data.title}
        </h1>
        <LeafDivider class="mt-6 max-w-52 sm:mt-7 sm:max-w-60" />
      </header>
      {
        familyMedia && (
          <figure class="mt-7 sm:mt-8">
            <ResponsiveMedia
              asset={familyMedia}
              alt={familyMedia.alt[locale]}
              sizes="(min-width: 640px) 650px, 100vw"
              className="aspect-4/3 w-full rounded-lg border border-cream-300 object-cover sm:aspect-3/2"
            />
            {familyMedia.credit && (
              <figcaption class="mt-1.5 text-xs text-ink-500">
                {t(locale, 'media.credit')}: {familyMedia.credit}
              </figcaption>
            )}
          </figure>
        )
      }
      <div class="prose-editorial mt-7 sm:mt-8">
        <Content />
      </div>
      {
        interiorMedia && (
          <figure class="mt-8">
            <ResponsiveMedia
              asset={interiorMedia}
              alt={interiorMedia.alt[locale]}
              sizes="(min-width: 640px) 650px, 100vw"
              className="aspect-3/2 w-full rounded-lg border border-cream-300 object-cover"
            />
            {interiorMedia.credit && (
              <figcaption class="mt-1.5 text-xs text-ink-500">
                {t(locale, 'media.credit')}: {interiorMedia.credit}
              </figcaption>
            )}
          </figure>
        )
      }
    </div>
  </article>
</Base>
