---
// Site search on Pagefind (static index generated at build time; the ONLY
// page that ships JavaScript — the zero-JS guarantee covers content pages,
// and search is impossible without it; see plan §7 which reserved Pagefind).
// Pagefind splits its index by html[lang], so each locale searches itself.
// noindex: thin search pages don't belong in Google (also filtered out of
// the sitemap in astro.config).
// Under `astro dev` the /pagefind/ assets don't exist yet — the fallback
// paragraph inside #search stays visible; run `pnpm build && pnpm preview`.
import Base from '../../layouts/Base.astro';
import { localeStaticPaths, type Locale } from '../../lib/i18n';
import { structuralAlternates } from '../../lib/urls';
import { t } from '../../lib/ui';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const alternates = structuralAlternates('/search/');

const title = {
  en: 'Search — Apple Vegan Cafe Pattaya',
  th: 'ค้นหา — Apple Vegan Cafe พัทยา',
  ru: 'Поиск — Apple Vegan Cafe, Паттайя',
}[locale];
const description = {
  en: 'Search all 141 dishes, prices and articles of Apple Vegan Cafe.',
  th: 'ค้นหาเมนูทั้ง 141 รายการ ราคา และบทความของร้าน',
  ru: 'Поиск по всем 141 блюдам, ценам и статьям кафе.',
}[locale];
---

<Base {locale} {title} {description} {alternates} noindex>
  <div class="wrap py-10 sm:py-14">
    <h1 class="font-display text-4xl font-extrabold tracking-tight text-leaf-900 sm:text-5xl">
      {t(locale, 'search.title')}
    </h1>
    <p class="mt-3 max-w-[52ch] text-ink-500">{t(locale, 'search.hint')}</p>

    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <div id="search" class="mt-8">
      <p class="text-ink-500">
        {
          locale === 'th'
            ? 'กำลังโหลดตัวค้นหา… ถ้าข้อความนี้ไม่หายไป แสดงว่าเบราว์เซอร์ปิด JavaScript อยู่ — ดูเมนูทั้งหมดได้ที่หน้าเมนูค่ะ'
            : locale === 'ru'
              ? 'Загружаем поиск… Если это сообщение не исчезло — в браузере выключен JavaScript; всё меню доступно на странице «Меню».'
              : 'Loading search… If this message stays, JavaScript is disabled — the full menu is on the Menu page.'
        }
      </p>
    </div>
    <script is:inline src="/pagefind/pagefind-ui.js"></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (typeof PagefindUI !== 'undefined') {
          document.querySelector('#search p')?.remove();
          new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
        }
      });
    </script>
  </div>
</Base>
