---
// Thai-only, fact-backed landing for the established local-intent URL.
// The former cultural/festival draft remains unpublished; this page uses only
// the same restaurant, menu, hours and contact sources as the rest of the site.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import JayBadge from '../../components/JayBadge.astro';
import ResponsiveMedia from '../../components/ResponsiveMedia.astro';
import Sprig from '../../components/Sprig.astro';
import type { Locale } from '../../lib/i18n';
import { absoluteUrl, localePath } from '../../lib/urls';
import { buildBreadcrumb } from '../../lib/jsonld';
import { getRegularHours } from '../../lib/hours';
import { t, type UiKey } from '../../lib/ui';

const locale: Locale = 'th';
const PAGE_PATH = '/th/ร้านอาหารเจ-พัทยา/';

const [settings] = (await getCollection('settings')).map((entry) => entry.data);
const [location] = (await getCollection('locations')).map((entry) => entry.data);
if (!settings || !location) throw new Error('settings/locations content is missing');

const menuPath = localePath(locale, '/menu/');
const contactPath = localePath(locale, '/contact/');
const phoneHref = `tel:${settings.phone.replace(/\s/g, '')}`;
const regularHours = getRegularHours(location.hours);
const mainHours = location.hours[0];
const dayLabel = (day: string) => t(locale, `days.${day}` as UiKey);
const daysLabel = (days: readonly string[]) =>
  days.length === 7
    ? t(locale, 'days.daily')
    : days.length > 2
      ? `${dayLabel(days[0]!)}–${dayLabel(days.at(-1)!)}`
      : days.map(dayLabel).join(', ');

const sampleDishes = (
  await getCollection(
    'dishes',
    ({ data }) => data.available && data.featured && data.dietaryTags.includes('jay'),
  )
)
  .map((entry) => entry.data)
  .slice(0, 4);

const alternates = { th: PAGE_PATH };
const site = Astro.site!;
const title = 'ร้านอาหารเจ 100% ในพัทยา | Apple Vegan Cafe';
const description =
  'Apple Vegan Cafe เป็นร้านอาหารเจและวีแกนในพัทยา ทุกเมนูทำจากพืช 100% ดูเมนูพร้อมรูปและราคา หรือเช็กเวลาเปิด-ปิดและข้อมูลติดต่อก่อนมา';
const jsonld = [
  buildBreadcrumb([
    { name: t(locale, 'nav.home'), url: absoluteUrl(site, localePath(locale, '/')) },
    { name: 'ร้านอาหารเจในพัทยา', url: absoluteUrl(site, PAGE_PATH) },
  ]),
];
---

<Base {locale} {title} {description} {alternates} {jsonld}>
  <section
    class="relative overflow-hidden bg-leaf-900 bg-[radial-gradient(60rem_30rem_at_85%_-10%,rgba(232,161,60,0.16),transparent_60%)] text-cream-100"
  >
    <Sprig
      class="pointer-events-none absolute top-4 -right-6 h-64 w-auto rotate-12 text-cream-100/10 sm:-top-4 sm:right-2 sm:h-80"
    />
    <Sprig
      class="pointer-events-none absolute -bottom-14 -left-10 h-52 w-auto -rotate-[30deg] text-mango-500/10"
    />
    <div class="wrap relative py-14 sm:py-20">
      <p class="rise">
        <JayBadge label={t(locale, 'trust.jay')} />
      </p>
      <h1
        class="rise rise-1 mt-5 max-w-[22ch] font-display text-4xl leading-[1.15] font-extrabold tracking-tight text-balance text-cream-50 sm:text-5xl"
      >
        ร้านอาหารเจ 100% ในพัทยา
      </h1>
      <p class="rise rise-2 mt-4 max-w-[52ch] text-lg text-leaf-200 sm:text-xl">
        Apple Vegan Cafe เป็นร้านอาหารเจและวีแกนของครอบครัวในพัทยา ทุกเมนูทำจากพืช 100%
      </p>
      {
        regularHours && mainHours && (
          <p
            data-special-hours-replaced
            class="rise rise-2 mt-6 inline-flex items-center gap-2.5 rounded-full border border-cream-100/25 px-4 py-2 text-sm font-medium"
          >
            <span class="h-2 w-2 rounded-full bg-mango-400" aria-hidden="true" />
            {daysLabel(mainHours.days)} {regularHours.range} น.
          </p>
        )
      }
      <div class="rise rise-3 mt-8 flex flex-wrap gap-3">
        <a
          href={menuPath}
          class="inline-flex min-h-12 items-center rounded-full bg-mango-500 px-7 text-base font-bold text-ink-900 transition-colors hover:bg-mango-300 focus-visible:outline-mango-300"
        >
          ดูเมนูพร้อมรูปและราคา
        </a>
        <a
          href={contactPath}
          class="inline-flex min-h-12 items-center rounded-full border border-cream-100/40 px-7 text-base font-semibold text-cream-100 transition-colors hover:border-cream-100 hover:bg-leaf-800 focus-visible:outline-mango-300"
        >
          เช็กที่อยู่และเวลาเปิด-ปิด
        </a>
      </div>
    </div>
  </section>

  <section class="wrap py-12 sm:py-14">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.65fr)] lg:items-start">
      <div>
        <p class="text-xs font-bold tracking-[0.14em] text-terracotta-700 uppercase">
          อาหารเจทุกวัน
        </p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-leaf-900 sm:text-4xl">
          เจและวีแกน 100%
        </h2>
        <p class="mt-4 max-w-[62ch] text-lg leading-relaxed text-ink-700">
          Apple Vegan Cafe เป็นร้านอาหารเจของครอบครัวในบางละมุง พัทยา ทุกเมนูเป็นอาหารจากพืช 100%
          และปรุงแบบเจ
        </p>
      </div>
      <aside class="rounded-2xl border border-mango-500/25 bg-mango-200/30 p-6">
        <h2 class="font-display text-xl font-bold text-leaf-900">ข้อมูลสำหรับผู้มีอาการแพ้</h2>
        <p class="mt-3 leading-relaxed text-ink-700">
          หากมีอาการแพ้รุนแรง กรุณาแจ้งทีมงานก่อนสั่งอาหาร
          ร้านยังไม่ได้เผยแพร่ขั้นตอนป้องกันการปนเปื้อนที่ตรวจสอบแล้ว
        </p>
        <a
          href={`${localePath(locale, '/faq/')}#cross-contact`}
          class="mt-4 inline-flex font-semibold text-leaf-800 underline decoration-mango-500 decoration-2 underline-offset-4 hover:text-leaf-900"
        >
          อ่านคำแนะนำเรื่องอาหารและอาการแพ้
        </a>
      </aside>
    </div>
  </section>

  {
    sampleDishes.length > 0 && (
      <section class="wrap pb-14 sm:pb-16">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-[0.14em] text-terracotta-700 uppercase">
              จากเมนูปัจจุบัน
            </p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-leaf-900 sm:text-4xl">
              ตัวอย่างเมนูเจ
            </h2>
          </div>
          <a
            href={menuPath}
            class="hidden font-semibold text-leaf-800 underline decoration-mango-500 decoration-2 underline-offset-4 hover:text-leaf-900 sm:inline"
          >
            ดูเมนูทั้งหมด →
          </a>
        </div>
        <ul class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {sampleDishes.map((dish) => (
            <li>
              <article class="group relative flex h-full flex-col rounded-lg border border-cream-300 bg-cream-50 p-4 transition-[border-color,box-shadow] hover:border-leaf-600/50 hover:shadow-[0_14px_34px_-20px_rgba(38,34,27,0.32)]">
                {dish.images[0] && (
                  <figure>
                    <ResponsiveMedia
                      asset={dish.images[0]}
                      alt={dish.name[locale]}
                      sizes="(min-width: 1280px) 280px, (min-width: 640px) 45vw, calc(100vw - 3rem)"
                      className="aspect-square w-full rounded-md border border-cream-300 bg-cream-100 object-cover"
                    />
                    {dish.images[0].credit ? (
                      <figcaption class="mt-1.5 text-xs text-ink-500">
                        {t(locale, 'media.credit')}: {dish.images[0].credit}
                      </figcaption>
                    ) : null}
                  </figure>
                )}
                <p class="mt-4 text-[11px] font-bold text-jay-700 uppercase">เจ · วีแกน</p>
                <h3 class="mt-1.5 text-lg leading-snug font-extrabold">
                  <a
                    href={`${menuPath}#${dish.slug[locale]}`}
                    class="transition-colors after:absolute after:inset-0 after:rounded-lg group-hover:text-leaf-800"
                  >
                    {dish.name[locale]}
                  </a>
                </h3>
                <p class="mt-auto pt-3 text-lg font-bold text-leaf-800 tabular-nums">
                  ฿{dish.price_thb}
                </p>
              </article>
            </li>
          ))}
        </ul>
        <p class="mt-7 sm:hidden">
          <a
            href={menuPath}
            class="inline-flex min-h-12 items-center rounded-full bg-leaf-700 px-7 font-bold text-cream-50 transition-colors hover:bg-leaf-800"
          >
            ดูเมนูทั้งหมดพร้อมราคา
          </a>
        </p>
      </section>
    )
  }

  <section class="wrap pb-6">
    <div
      class="relative overflow-hidden rounded-3xl border border-leaf-100 bg-leaf-50 px-6 py-8 sm:px-10 sm:py-10"
    >
      <Sprig
        class="pointer-events-none absolute -right-6 -bottom-9 h-44 w-auto text-leaf-700 opacity-[0.13]"
      />
      <h2 class="relative font-display text-2xl font-bold tracking-tight text-leaf-900 sm:text-3xl">
        ที่อยู่และเวลาเปิด-ปิด
      </h2>
      <div class="relative mt-6 grid gap-8 sm:grid-cols-2">
        <div>
          <h3 class="text-xs font-bold tracking-[0.14em] text-terracotta-700 uppercase">ที่อยู่</h3>
          <address class="mt-2 max-w-[38ch] leading-relaxed not-italic">
            {location.address[locale]}
          </address>
        </div>
        <div>
          <h3 class="text-xs font-bold tracking-[0.14em] text-terracotta-700 uppercase">
            เวลาปกติ
          </h3>
          <dl class="mt-2 space-y-1.5">
            {
              location.hours.map((hours) => (
                <div
                  data-special-hours-replaced
                  class="flex flex-wrap gap-x-3 text-lg font-semibold"
                >
                  <dt>{daysLabel(hours.days)}</dt>
                  <dd class="tabular-nums">
                    {hours.open}–{hours.close} น.
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
      <div class="relative mt-7 flex flex-wrap gap-3">
        <a
          href={contactPath}
          class="inline-flex min-h-12 items-center rounded-full bg-leaf-700 px-6 font-bold text-cream-50 transition-colors hover:bg-leaf-800"
        >
          ดูข้อมูลติดต่อ
        </a>
        <a
          href={phoneHref}
          class="inline-flex min-h-12 items-center rounded-full border border-leaf-700/40 px-6 font-semibold text-leaf-800 transition-colors hover:border-leaf-700 hover:bg-leaf-100"
        >
          โทร {settings.phone}
        </a>
      </div>
    </div>
  </section>
</Base>
