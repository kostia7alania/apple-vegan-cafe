---
import type { Locale } from '../lib/i18n';
import { t } from '../lib/ui';

interface SpecialHour {
  date: string;
  open: string | null;
  close: string | null;
  note?: string;
}

interface Props {
  locale: Locale;
  specialHours: readonly SpecialHour[];
  className?: string;
}

const { locale, specialHours, className = '' } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat({ en: 'en-GB', th: 'th-TH', ru: 'ru-RU' }[locale], {
  day: 'numeric',
  month: 'short',
  timeZone: 'UTC',
});
const displayDate = (date: string) => dateFormatter.format(new Date(`${date}T00:00:00Z`));
const noScriptText = {
  en: 'Special hours are scheduled and may replace the usual schedule. Please call before visiting.',
  th: 'มีเวลาเปิด-ปิดพิเศษซึ่งอาจแทนเวลาปกติ กรุณาโทรสอบถามก่อนเดินทางมาร้าน',
  ru: 'Есть особые часы, которые могут заменять обычное расписание. Перед визитом позвоните в кафе.',
}[locale];
---

{
  specialHours.length > 0 && (
    <div
      data-special-hours-root
      class:list={[
        'rounded-lg bg-mango-100 px-3 py-2 text-sm font-semibold text-ink-900',
        className,
      ]}
      aria-live="polite"
    >
      <p data-special-hours-fallback>{noScriptText}</p>
      {specialHours.map((hours) => {
        const todayText =
          hours.open && hours.close
            ? t(locale, 'hours.specialOpen')
                .replace('{open}', hours.open)
                .replace('{close}', hours.close)
            : t(locale, 'hours.specialClosed');
        const upcomingText =
          hours.open && hours.close
            ? t(locale, 'hours.specialOpenOn')
                .replace('{date}', displayDate(hours.date))
                .replace('{open}', hours.open)
                .replace('{close}', hours.close)
            : t(locale, 'hours.specialClosedOn').replace('{date}', displayDate(hours.date));

        return (
          <p hidden data-special-hours-entry data-date={hours.date} class="not-last:mb-1.5">
            <span data-special-hours-today>{todayText}</span>
            <span hidden data-special-hours-upcoming>
              {upcomingText}
            </span>
          </p>
        );
      })}
    </div>
  )
}
