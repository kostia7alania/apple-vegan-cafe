{
  // Assets-only Worker: no script, no SSR. Static asset requests are free and
  // unlimited on every Cloudflare plan. Production deploys only through the
  // gated GitHub Actions CI workflow, which consumes this config.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "apple-vegan-cafe",
  "compatibility_date": "2026-07-15",
  // Custom domain attaches automatically on deploy (zone must exist in the account).
  // HTTP→HTTPS (Always Use HTTPS) and www→apex are zone-level settings in the
  // Cloudflare dashboard. Keep this deploy assets-only; see docs/runbook.md.
  "routes": [{ "pattern": "apple-vegan-cafe.com", "custom_domain": true }],
  "assets": {
    // relative to this config file
    "directory": "../dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
